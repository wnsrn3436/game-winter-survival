    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if(global.select=char)
{
    hspeed = 3*(keyboard_check(vk_right)-keyboard_check(vk_left))
    vspeed = 3*(keyboard_check(vk_down)-keyboard_check(vk_up))
    if(hspeed!=0 or vspeed!=0)
    {
        image_index = round(direction/45)
        if(alarm[0]=-1){alarm[0]=room_speed/4}
        if(walking_soundid=noone){walking_soundid=audio_play_sound(sound_walking, 0, true)}
        if(!place_free(x+hspeed, y+vspeed)){hspeed=0; vspeed=0}
    }
    else
    {
        walking=false
        alarm[0]=-1
        if(walking_soundid!=noone){audio_stop_sound(walking_soundid); walking_soundid=noone}
    }
    for(i=0; i!=6; i+=1)
    {
        if(keyboard_check_released(49+i))
        {
            if(item2[i]!=noone)
            {
                item2_choose[i] = !item2_choose[i]
                audio_play_sound(sound_item_select, 0, false)
            }
        }
    }
    if(keyboard_check_released(ord('X')))
    {
        var vardrop=false;
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                ins = instance_create(floor((bbox_right+bbox_left)/2), bbox_bottom-10, obj_item_drop)
                ins.kind = item2[i]
                item2[i] = noone
                item2_choose[i] = false
                vardrop=true
            }
        }
        if(vardrop){audio_play_sound(sound_item_drop, 0, false)}
    }
    if(keyboard_check_released(ord('A')))
    {
        for(i=0; i!=6; i+=1)
        {
            if(item2[i]=9)
            {
                satiety=min(100, satiety+10)
                item2[i] = noone
                item2_choose[i] = false
                audio_play_sound(sound_item_meat, 0, false)
                break
            }
        }
    }
    var_sum=0
    for(i=0; i!=10; i+=1){var_item[i]=0}
    for(i=0; i!=6; i+=1){if(item2_choose[i]!=false){var_item[item2[i]]+=1; var_sum+=1}}
    if(var_item[0]=3 and var_item[2]=1 and var_sum=4)
    {
        instance_create(floor((bbox_right+bbox_left)/2), bbox_bottom-10, obj_fire)
        audio_play_sound(sound_item_found, 0, false)
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                item2[i] = noone
                item2_choose[i] = false
            }
        }
    }
    else if(var_item[0]=2 and var_item[1]=1 and var_sum=3)
    {
        item[0] = 5
        alarm[2] = room_speed*30
        audio_play_sound(sound_item_found, 0, false)
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                item2[i] = noone
                item2_choose[i] = false
            }
        }
    }
    else if(var_item[0]=1 and var_item[1]=1 and var_sum=2)
    {
        if(item[1]!=noone)
        {
            ins = instance_create(floor((bbox_right+bbox_left)/2), bbox_bottom-10, obj_item_drop)
            ins.kind = item[1]
        }
        item[1]=8
        audio_play_sound(sound_item_found, 0, false)
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                item2[i] = noone
                item2_choose[i] = false
            }
        }
    }
    else if(var_item[0]=1 and var_item[4]=1 and var_sum=2)
    {
        if(item[1]!=noone)
        {
            ins = instance_create(floor((bbox_right+bbox_left)/2), bbox_bottom-10, obj_item_drop)
            ins.kind = item[1]
        }
        item[1]=6
        audio_play_sound(sound_item_found, 0, false)
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                item2[i] = noone
                item2_choose[i] = false
            }
        }
    }
    else if(var_item[0]=1 and var_item[1]=1 and var_item[3]=1 and var_item[4]=1 and var_sum=4)
    {
        if(item[1]!=noone)
        {
            ins = instance_create(floor((bbox_right+bbox_left)/2), bbox_bottom-10, obj_item_drop)
            ins.kind = item[1]
        }
        item[1]=7
        audio_play_sound(sound_item_found, 0, false)
        for(i=0; i!=6; i+=1)
        {
            if(item2_choose[i]!=false)
            {
                item2[i] = noone
                item2_choose[i] = false
            }
        }
    }
    if(item[0]!=noone)
    {
        if(!instance_exists(obj_hand_fire)){instance_create(-100, -100, obj_hand_fire)}
    }
    else{with(obj_hand_fire){instance_destroy()}}
    switch(item[1])
    {
        case 6:
            if(!instance_exists(obj_knife)){instance_create(-100, -100, obj_knife)}
            with(obj_pistol){instance_destroy()}
            with(obj_hammer){instance_destroy()}
            break
        case 7:
            if(!instance_exists(obj_pistol)){instance_create(-100, -100, obj_pistol)}
            with(obj_knife){instance_destroy()}
            with(obj_hammer){instance_destroy()}
            break
        case 8:
            if(!instance_exists(obj_hammer)){instance_create(-100, -100, obj_hammer)}
            with(obj_knife){instance_destroy()}
            with(obj_pistol){instance_destroy()}
            break
        case noone:
            with(obj_knife){instance_destroy()}
            with(obj_pistol){instance_destroy()}
            with(obj_hammer){instance_destroy()}
            break
    }
}
else
{
    ins = instance_create(x, y, obj_die)
    ins.char = char
    instance_destroy()
}
</string>
          </argument>
        </arguments>
      </action>
