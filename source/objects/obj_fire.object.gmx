part_type_gravity(pt, 0.03, 0)
part_type_orientation(pt, 0, 0, 0, 0, true)
part_type_blend(pt, true)
part_type_life(pt, 30, 60)

em = part_emitter_create(ps)
part_emitter_region(ps, em, x+15, x+20, y-5, y+5, ps_shape_diamond, ps_distr_gaussian)
part_emitter_stream(ps, em, pt, 1)

alarm[0] = 5
alarm[1] = 30
alarm[2] = room_speed*60
life = 2
soundid = noone
</string>
          </argument>
        </arguments>
      </action>
    </event>
