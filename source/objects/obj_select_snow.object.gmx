        <arguments>
          <argument>
            <kind>1</kind>
            <string>ps = part_system_create()
part_system_depth(ps, -100000)

pt2 = part_type_create()
part_type_shape(pt2, pt_shape_sphere)
part_type_scale(pt2, 0.08, 0.08)
part_type_color1(pt2, c_white)
part_type_alpha2(pt2, 0.5, 0)
part_type_life(pt2, 30, 30)

pt = part_type_create()
part_type_shape(pt, pt_shape_disk)
part_type_scale(pt, 0.1, 0.1)
part_type_color1(pt, c_white)
part_type_alpha3(pt, 1, 0.5, 0)
part_type_speed(pt, 1, 1, 0.05, 0)
part_type_direction(pt, 270, 270, 0, 0)
part_type_orientation(pt, 0, 0, 0, 0, true)
part_type_life(pt, 10, 120)
part_type_death(pt, 1, pt2)

em = part_emitter_create(ps)
part_emitter_region(ps, em, 0, room_width+10, 0, 50, ps_shape_rectangle, ps_distr_linear)
part_emitter_stream(ps, em, pt, 1)

randomize()
</string>
          </argument>
