        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>part_emitter_destroy_all(ps)
part_type_destroy(pt)
part_type_destroy(pt2)
part_system_destroy(ps)
</string>
          </argument>
        </arguments>
      </action>
    </event>
