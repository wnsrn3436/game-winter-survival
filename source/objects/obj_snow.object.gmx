    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_color(c_gray)
if alarm[4]=-1{draw_text(320, 10, string(floor(alarm[3]/60/60))+":"+string(floor((alarm[3]/60) mod 60)))}
draw_set_alpha(0.3)
draw_sprite(spr_ico_temperature, -1, 10, 10)
draw_sprite(spr_ico_satiety, -1, 12, 80)
draw_sprite(spr_ico_life, -1, 16, 133)
draw_set_alpha(1)
if(instance_exists(global.playchar))
{
    var_state = floor(max(0, (100-global.playchar.temperature)/2))
    draw_sprite_part(spr_ico_temperature, -1, 0, var_state, 43, 50-var_state, 10, 10+var_state)
    var_state = floor(max(0, (100-global.playchar.satiety)/3))
    draw_sprite_part(spr_ico_satiety, -1, 0, var_state, 37, 33-var_state, 12, 80+var_state)
    var_state = ceil(max(0, (100-global.playchar.life)/3))
    draw_sprite_part(spr_ico_life, -1, 0, var_state, 34, 34-var_state, 16, 133+var_state)
    if(global.playchar.item[0]!=noone)
    {
        draw_sprite_ext(spr_item_hand_fire, -1, 10, 340, 0.5, 0.5, 0, c_white, 0.3)
        var_state = ceil(max(0, (1800-global.playchar.alarm[2])/26))
        draw_sprite_part_ext(spr_item_hand_fire, -1, 0, var_state, 75, 75-var_state, 10, 340+(var_state/2)+0.5, 0.5, 0.5, c_white, 1)
    }
    switch(global.playchar.item[1])
    {
        case 6:
            draw_sprite_ext(spr_item_knife, -1, 55, 340, 0.5, 0.5, 0, c_white, 1)
            break
        case 7:
            draw_sprite_ext(spr_item_pistol, -1, 55, 340, 0.5, 0.5, 0, c_white, 1)
            break
        case 8:
            draw_sprite_ext(spr_item_hammer, -1, 55, 340, 0.5, 0.5, 0, c_white, 1)
            break
    }
    for(i=0; i!=6; i+=1)
    {
        switch(global.playchar.item2[i])
        {
        case 0:
            draw_sprite_ext(spr_item_branches, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        case 1:
            draw_sprite_ext(spr_item_stone_small, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        case 2:
            draw_sprite_ext(spr_item_stone_big, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        case 3:
            draw_sprite_ext(spr_item_leather, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        case 4:
            draw_sprite_ext(spr_item_ice, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        case 9:
            draw_sprite_ext(spr_item_meat, -1, 10+(i*35), 385, 0.5, 0.5, 0, c_white, 0.5+(0.5*global.playchar.item2_choose[i]))
            draw_set_color(c_black)
            draw_text(15+(i*35), 400, i+1)
            break
        }
    }
}
if(blood)
{
    draw_set_alpha(alarm[2]/200)
    draw_sprite(spr_blood, -1, 0, 0)
    draw_set_alpha(1)
}
if alarm[0]!=-1
{
    draw_set_color(c_black)
    draw_set_alpha(alarm[0]/(room_speed*3))
    draw_rectangle(0, 0, view_wview[0], view_hview[0], 0)
    draw_set_alpha(1)
}
if alarm[4]!=-1
{
    draw_set_color(c_black)
    draw_set_alpha((room_speed*3-alarm[4])/(room_speed*3))
    draw_rectangle(0, 0, 640, 480, 0)
    draw_set_alpha(1)
}
</string>
