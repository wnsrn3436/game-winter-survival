          <argument>
            <kind>1</kind>
            <string>instance_create(room_width/2, room_height/2, obj_fire)
for(i=0; i!=4; i+=1)
{
    ins = instance_create(room_width/2, room_height/2, obj_char)
    ins.char = i
    switch(i)
    {
        case 0:
            ins.sprite_index = spr_francis
            break
        case 1:
            ins.sprite_index = spr_louis
            break
        case 2:
            ins.sprite_index = spr_zoey
            break
        case 3:
            ins.sprite_index = spr_bill
            break
    }
    if(global.select=i){global.playchar = ins}
}
with(obj_char)
{
    if(global.select=char)
    {
        view_xview[0] = floor((bbox_right+bbox_left)/2)
        view_yview[0] = floor((bbox_bottom+bbox_top)/2)
        view_xview[0] = view_xview[0] - view_wview[0]/2
        view_yview[0] = view_yview[0] - view_hview[0]/2
        break
    }
}
with(obj_char)
{
    switch(char)
    {
        case 0:
            x = view_xview[0]+238
            y = view_yview[0]+206
            break
        case 1:
            x = view_xview[0]+318
            y = view_yview[0]+286
            break
        case 2:
            x = view_xview[0]+402
            y = view_yview[0]+206
            break
        case 3:
            x = view_xview[0]+326
            y = view_yview[0]+146
            break
    }
}
alarm[0] = room_speed*3

soundid = noone
soundplaying = noone
global.getit = false
alarm[1] = room_speed*10
draw_set_font(font_game)
blood = false
alarm[3]=room_speed*900
</string>
